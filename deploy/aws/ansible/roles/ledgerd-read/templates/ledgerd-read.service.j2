[Unit]
Description=LEDGERD read replica
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ledgerd_user }}
Group={{ ledgerd_user }}
Environment=JAVA_HOME={{ jdk_home }}
Environment=LEDGERD_ARCHIVE_CHANNELS={{ ledgerd_archive_channels }}
Environment=LEDGERD_LOCAL_HOST={{ ansible_host }}
Environment=LEDGERD_AERON_DIR={{ ledgerd_data_root }}/driver
Environment=LEDGERD_QUERY_CHANNEL=aeron:udp?endpoint={{ ansible_host }}:{{ ledgerd_query_port }}
ExecStart={{ jdk_home }}/bin/java \
  -Xms{{ ledgerd_heap }} -Xmx{{ ledgerd_heap }} \
  -XX:+UseZGC -XX:+AlwaysPreTouch -XX:+ExitOnOutOfMemoryError \
  --add-opens java.base/jdk.internal.misc=ALL-UNNAMED \
  --add-opens java.base/sun.nio.ch=ALL-UNNAMED \
  -Dledgerd.threadingMode={{ ledgerd_threading_mode }} \
  -Dledgerd.socketSndbufLength={{ ledgerd_socket_buf_length }} \
  -Dledgerd.socketRcvbufLength={{ ledgerd_socket_buf_length }} \
  -cp "{{ ledgerd_lib_dir }}/*" \
  io.justrade.ledgerd.read.ReadServiceLauncher
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
