global:
  scrape_interval: 5s
  evaluation_interval: 5s

scrape_configs:
  - job_name: ledgerd
    static_configs:
      - targets:
{% for host in (groups['nodes'] | sort) %}
        - "{{ hostvars[host]['ansible_host'] }}:{{ ledgerd_metrics_base_port + (hostvars[host]['ledgerd_node_id'] | int) }}"
{% endfor %}
