{
  "uid": "ledgerd-bench-batch",
  "title": "LEDGERD Bench: Transfer Batch",
  "description": "Transfer-batch load benchmark (ADR 0012). Throughput is measured in legs/s; latency is the merged batch end-to-end latency across clients.",
  "tags": ["ledgerd", "bench", "batch"],
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Transfer legs (legs/s)",
      "description": "Transfer legs per second across all concurrent clients.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        { "expr": "ledgerd_batch_legs_per_sec", "legendFormat": "legs/batch={{legs_per_batch}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consensus appends (batches/s)",
      "description": "Consensus batch appends per second; each batch carries legs_per_batch transfer legs.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "ledgerd_batch_batches_per_sec", "legendFormat": "legs/batch={{legs_per_batch}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "Latency (merged)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "p50 latency (ms)",
      "description": "True combined batch p50 across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "targets": [
        { "expr": "ledgerd_batch_p50_us / 1000", "legendFormat": "legs/batch={{legs_per_batch}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p99 latency (ms)",
      "description": "True combined batch p99 across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "targets": [
        { "expr": "ledgerd_batch_p99_us / 1000", "legendFormat": "legs/batch={{legs_per_batch}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p99.9 latency (ms)",
      "description": "True combined batch p99.9 across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "ledgerd_batch_p999_us / 1000", "legendFormat": "legs/batch={{legs_per_batch}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "max latency (ms)",
      "description": "True combined batch max across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "expr": "ledgerd_batch_max_us / 1000", "legendFormat": "legs/batch={{legs_per_batch}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    }
  ]
}
