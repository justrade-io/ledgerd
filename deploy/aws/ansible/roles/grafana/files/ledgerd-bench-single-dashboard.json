{
  "uid": "ledgerd-bench-single",
  "title": "LEDGERD Bench: Single Command",
  "description": "Single-command load benchmark latency. Merged series are the true combined percentile across clients; max-of-client series show the conservative per-client upper bound.",
  "tags": ["ledgerd", "bench"],
  "refresh": "5s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Latency (merged)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 latency (ms)",
      "description": "True combined p50 across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "targets": [
        { "expr": "ledgerd_bench_p50_us / 1000", "legendFormat": "in-flight={{max_in_flight}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p99 latency (ms)",
      "description": "True combined p99 across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "targets": [
        { "expr": "ledgerd_bench_p99_us / 1000", "legendFormat": "in-flight={{max_in_flight}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p99.9 latency (ms)",
      "description": "True combined p99.9 across all concurrent clients (HdrHistogram merge).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        { "expr": "ledgerd_bench_p999_us / 1000", "legendFormat": "in-flight={{max_in_flight}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "Per-client max",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "p50 max-of-client (ms)",
      "description": "Conservative per-client p50 upper bound. Compare with the merged p50 to see cross-client skew.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "targets": [
        { "expr": "ledgerd_bench_p50_max_us / 1000", "legendFormat": "in-flight={{max_in_flight}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p99 max-of-client (ms)",
      "description": "Conservative per-client p99 upper bound. Compare with the merged p99 to see cross-client skew.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "targets": [
        { "expr": "ledgerd_bench_p99_max_us / 1000", "legendFormat": "in-flight={{max_in_flight}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Client",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Client backpressure",
      "description": "Client-side backpressure events from the in-flight window.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "targets": [
        { "expr": "ledgerd_bench_backpressure", "legendFormat": "in-flight={{max_in_flight}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }
      }
    }
  ]
}
