# Renders the Ansible inventory directly from Terraform outputs, so the
# clusterMembers / ingressEndpoints / archiveChannels strings are always
# consistent with the actual private IPs. YAML (rather than INI) is used so the
# Aeron channel strings containing '=', ':', '?' and '|' need no escaping.

locals {
  inventory = {
    all = {
      vars = {
        ansible_user                 = "ubuntu"
        ansible_ssh_private_key_file = abspath(var.ssh_private_key_path)
        ansible_python_interpreter   = "/usr/bin/python3"
        ansible_ssh_common_args      = "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"

        ledgerd_cluster_members   = local.cluster_members
        ledgerd_ingress_endpoints = local.ingress_endpoints
        ledgerd_archive_channels  = local.archive_channels
      }
      children = {
        nodes = {
          hosts = {
            for i in range(var.node_count) : "node-${i}" => {
              ansible_host    = aws_instance.node[i].private_ip
              ledgerd_node_id = i
            }
          }
        }
        read = {
          hosts = {
            read-0 = {
              ansible_host = aws_instance.read.private_ip
            }
          }
        }
        bench = {
          hosts = {
            bench-0 = {
              ansible_host = aws_instance.bench.private_ip
            }
          }
        }
        monitor = {
          hosts = {
            (var.split_bench_monitor ? "monitor" : "bench-0") = {
              ansible_host = var.split_bench_monitor ? aws_instance.monitor[0].private_ip : aws_instance.bench.private_ip
            }
          }
        }
      }
    }
  }
}

resource "local_file" "inventory" {
  filename = "${path.module}/../ansible/inventory/hosts.yml"
  content  = "# Auto-generated by Terraform. Do not edit by hand.\n${yamlencode(local.inventory)}"
}
